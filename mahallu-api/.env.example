PORT=4000
MONGODB_URI=your_mongodb_connection_string_here
JWT_SECRET=your_jwt_secret_here

# DigitalOcean Spaces (required for /api/upload/* endpoints)
DO_SPACES_ENDPOINT=
DO_SPACES_KEY=
DO_SPACES_SECRET=
DO_SPACES_BUCKET=
# Optional custom folder/prefix inside bucket (default: uploads)
DO_SPACES_FOLDER=uploads
# Optional CDN endpoint, e.g. https://cdn.example.com
DO_SPACES_CDN_ENDPOINT=
NODE_ENV=production
DXING_SECRET=your_dxing_secret_here
DXING_ACCOUNT=your_dxing_account_here
DXING_DIAG=1
SUPER_ADMIN_PHONE=your_super_admin_phone_here
SUPER_ADMIN_PASSWORD=your_super_admin_password_here
SUPER_ADMIN_EMAIL=your_super_admin_email_here
SUPER_ADMIN_NAME="Super Admin"

# AI assistant (/api/assistant/query). Without the key the endpoint returns 503 not_configured.
OPENROUTER_API_KEY=
# Default model if unset: google/gemini-2.5-flash
AI_MODEL=google/gemini-2.5-flash
# Questions per user per day for the AI assistant (default 30)
AI_DAILY_LIMIT=30
# Optional overrides
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_SITE_URL=https://jamaahhub.com