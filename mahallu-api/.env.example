PORT=5000
MONGODB_URI=mongodb+srv://<db-user>:<db-password>@<cluster-host>/<db-name>?retryWrites=true&w=majority
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=<generate-a-long-random-secret>

# DigitalOcean Spaces (required for /api/upload/* endpoints)
DO_SPACES_ENDPOINT=<region>.digitaloceanspaces.com
DO_SPACES_KEY=<spaces-access-key>
DO_SPACES_SECRET=<spaces-secret-key>
DO_SPACES_BUCKET=<bucket-name>
# Optional custom folder/prefix inside bucket (default: uploads)
DO_SPACES_FOLDER=uploads
# Optional CDN endpoint, e.g. https://cdn.example.com
DO_SPACES_CDN_ENDPOINT=
# MUST be "production" in production. Only "development" exposes OTPs in API responses.
NODE_ENV=development
DXING_SECRET=<dxing-secret>
DXING_ACCOUNT=<dxing-account>
DXING_DIAG=
SUPER_ADMIN_PHONE=<10-digit-phone>
SUPER_ADMIN_PASSWORD=<choose-a-strong-password>
SUPER_ADMIN_EMAIL=<admin@example.com>
SUPER_ADMIN_NAME=<Super Admin>

# Comma-separated list of browser origins allowed by CORS (unset = allow all)
CORS_ORIGINS=
# Number of reverse-proxy hops to trust for req.ip (e.g. 1 on Railway/Heroku); unset = none
TRUST_PROXY=
# Initial password for auto-created accounts (unset = random per account)
DEFAULT_MEMBER_PASSWORD=
# App Store review test account with FIXED OTP 123456. Leave unset/false everywhere except
# a dedicated review environment: it auto-creates a super_admin user.
ENABLE_APP_STORE_TEST_ACCOUNT=false

# AI assistant (/api/assistant/query). Without the key the endpoint returns 503 not_configured.
OPENROUTER_API_KEY=<openrouter-api-key>
# Default model if unset: google/gemini-2.5-flash
AI_MODEL=google/gemini-2.5-flash
# Questions per user per day for the AI assistant (default 30)
AI_DAILY_LIMIT=30
# Optional overrides
OPENROUTER_BASE_URL=
OPENROUTER_SITE_URL=

# --- Notification channels (announcements). Each channel is OFF until its keys are set. ---
# WhatsApp uses DXING_SECRET / DXING_ACCOUNT above. Phone push alerts (in-app list always works):
ONESIGNAL_APP_ID=<onesignal-app-id>
ONESIGNAL_REST_API_KEY=<onesignal-rest-api-key>
# SMS gateway (generic JSON over HTTPS; adapt payload in services/notificationChannels.ts)
SMS_PROVIDER_NAME=<gateway-name>
SMS_PROVIDER_URL=<https://sms-gateway.example/send>
SMS_PROVIDER_API_KEY=<sms-api-key>
SMS_PROVIDER_SENDER_ID=<sender-id>
# Email over SMTP (also needs: npm install nodemailer)
SMTP_HOST=<smtp.example.com>
SMTP_PORT=587
SMTP_USER=<smtp-user>
SMTP_PASS=<smtp-password>
SMTP_FROM=<mahallu@example.com>
# Set to 1 on dev/staging: announcements record statuses but nothing is actually sent
NOTIFICATIONS_DRY_RUN=
# Cash day boundary as minutes from UTC (default 330 = IST)
CASH_DAY_TZ_OFFSET_MIN=
