# Local development API (the dev server falls back to this when unset).
# Production builds REQUIRE an https:// URL here - set it in the hosting provider, not in a committed file.
VITE_API_URL=http://localhost:4000/api
# VITE_ONESIGNAL_APP_ID=
# Build-time CSP guard (see DEPLOYMENT.md): a production build fails while netlify.toml still has the
# API-origin placeholder. Set to true ONLY for a local verification build; never on the hosting provider.
# VITE_ALLOW_CSP_PLACEHOLDER=
# Local production preview against a local API only (see DEPLOYMENT.md); never on the hosting provider.
# VITE_ALLOW_LOCAL_API=
